{
  "manifest_version": 2,
  "id": "local.proactive-ping",
  "name": "主动敲门 (Proactive Ping)",
  "version": "0.2.0",
  "description": "冷场时提醒 MaiBot 的 planner 自主决定要不要主动开口。支持在 WebUI 中配置提示词、探测间隔、空闲阈值、冷却、每日上限与静默时段。插件不调用模型、不直接发消息。",
  "author": {
    "name": "zzy-fxxxexxxyxxx",
    "url": "https://github.com/zzy-fxxxexxxyxxx"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping",
    "homepage": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping",
    "documentation": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping#readme",
    "issues": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping/issues"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_private_streams",
    "message.get_recent",
    "maisaka.proactive.trigger"
  ],
  "plugin_type": "extension",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}