{
  "manifest_version": 2,
  "id": "local.proactive-ping",
  "name": "主动敲门 (Proactive Ping)",
  "version": "0.2.0",
  "description": "按空闲时长探测聊天流，达到阈值时提醒 MaiBot 的 planner 自主决定是否主动开口。支持在 WebUI 中配置提示词、探测间隔、空闲阈值、冷却、每日上限与静默时段。插件不调用模型、不直接发消息。",
  "author": {
    "name": "local",
    "url": "https://github.com/Mai-with-u/MaiBot"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot",
    "homepage": "https://github.com/Mai-with-u/MaiBot",
    "documentation": "https://docs.mai-mai.org",
    "issues": "https://github.com/Mai-with-u/MaiBot/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_private_streams",
    "message.get_recent",
    "maisaka.proactive.trigger"
  ],
  "plugin_type": "extension",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
