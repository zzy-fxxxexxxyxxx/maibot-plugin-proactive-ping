{
  "manifest_version": 2,
  "id": "github.zzy-fxxxexxxyxxx.proactive-ping",
  "version": "0.3.0",
  "name": "主动敲门 (Proactive Ping)",
  "description": "冷场时提醒 MaiBot 的 planner 自主决定要不要主动找你。可配置探测间隔、空闲阈值、冷却、每日上限、静默时段与提示词；插件不调用模型、不直接发消息。",
  "author": {
    "name": "zzy-fxxxexxxyxxx",
    "url": "https://github.com/zzy-fxxxexxxyxxx"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping",
    "homepage": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping",
    "documentation": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping/blob/main/README.md",
    "issues": "https://github.com/zzy-fxxxexxxyxxx/maibot-plugin-proactive-ping/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.9.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_private_streams",
    "message.get_recent",
    "maisaka.proactive.trigger"
  ],
  "plugin_type": "extension",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}